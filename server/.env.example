# Server Port
PORT=5000

# Environment mode
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB local or Atlas URI)
# If local MongoDB is not running, server gracefully falls back to in-memory store for testing!
MONGODB_URI=mongodb://localhost:27017/moviemeet

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_928374

# WebRTC STUN and TURN Servers
# Primary STUN server (Google public STUN)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN server for restrictive symmetric NATs
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
